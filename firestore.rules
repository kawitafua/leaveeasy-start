rules_version = '2';

// สัปดาห์ที่ 7: กฎขั้นต่ำ — ต้องล็อกอินก่อนถึงจะอ่าน/เขียนอะไรได้
// ยังไม่แยกสิทธิ์ตามคนหรือตามบทบาท (employee/manager/hr) — เรื่องนั้นเป็นของสัปดาห์ที่ 8
// {document=**} ครอบทุกโฟลเดอร์ รวมโฟลเดอร์ย่อย leaveRequests/{id}/approvals ด้วยในตัว
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
